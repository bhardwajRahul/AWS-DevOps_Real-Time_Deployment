# Production Environment Configuration
# This file contains environment-specific settings for production

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=error

# Server Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=2048
NGINX_KEEPALIVE_TIMEOUT=30

# Security Settings (strict for production)
SECURITY_HEADERS_ENABLED=true
CSP_POLICY strict
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=10

# Performance Settings
GZIP_COMPRESSION_ENABLED=true
STATIC_CACHING_ENABLED=true
BROWSER_CACHING_MAX_AGE=31536000

# Monitoring and Logging
ACCESS_LOG_ENABLED=true
ERROR_LOG_ENABLED=true
MONITORING_ENABLED=true
ALERTING_ENABLED=true

# Database (if applicable)
DB_HOST=prod-db-cluster.example.com
DB_PORT=3306
DB_NAME=devops_prod
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# API Settings
API_BASE_URL=https://api.example.com
API_TIMEOUT=10
API_RETRIES=2

# SSL/TLS Settings
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/example.com.crt
SSL_KEY_PATH=/etc/ssl/private/example.com.key
SSL_PROTOCOLS=TLSv1.2 TLSv1.3

# Feature Flags
ENABLE_MAINTENANCE_MODE=false
ENABLE_BETA_FEATURES=false
ENABLE_DEBUG_TOOLBAR=false

# Development Tools (disabled in production)
ENABLE_PROFILER=false
ENABLE_QUERY_LOG=false
ENABLE_PERFORMANCE_MONITORING=true

# Backup and Recovery
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
AUTO_RECOVERY_ENABLED=true

# CDN Configuration
CDN_ENABLED=true
CDN_DOMAIN=cdn.example.com
CDN_CACHE_TTL=3600
