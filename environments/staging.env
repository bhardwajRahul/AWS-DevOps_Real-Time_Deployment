# Staging Environment Configuration
# This file contains environment-specific settings for staging

# Application Settings
APP_ENV="staging"
APP_DEBUG=true
APP_LOG_LEVEL="info"

# Server Configuration
NGINX_WORKER_PROCESSES="auto"
NGINX_WORKER_CONNECTIONS=1536
NGINX_KEEPALIVE_TIMEOUT=45

# Security Settings (moderate for staging)
SECURITY_HEADERS_ENABLED=true
CSP_POLICY="moderate"
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=20

# Performance Settings
GZIP_COMPRESSION_ENABLED=true
STATIC_CACHING_ENABLED=true
BROWSER_CACHING_MAX_AGE=3600

# Monitoring and Logging
ACCESS_LOG_ENABLED=true
ERROR_LOG_ENABLED=true
MONITORING_ENABLED=true
ALERTING_ENABLED=false

# Database (if applicable)
DB_HOST="staging-db.example.com"
DB_PORT=3306
DB_NAME="devops_staging"
DB_USER="staging_user"
DB_PASSWORD="staging_password"

# API Settings
API_BASE_URL="https://staging-api.example.com"
API_TIMEOUT=15
API_RETRIES=3

# SSL/TLS Settings
SSL_ENABLED=true
SSL_CERT_PATH="/etc/ssl/certs/staging.example.com.crt"
SSL_KEY_PATH="/etc/ssl/private/staging.example.com.key"
SSL_PROTOCOLS="TLSv1.2 TLSv1.3"

# Feature Flags
ENABLE_MAINTENANCE_MODE=false
ENABLE_BETA_FEATURES=true
ENABLE_DEBUG_TOOLBAR=true

# Development Tools
ENABLE_PROFILER=true
ENABLE_QUERY_LOG=true
ENABLE_PERFORMANCE_MONITORING=true

# Testing Configuration
ENABLE_LOAD_TESTING=true
LOAD_TEST_CONCURRENT_USERS=50
LOAD_TEST_DURATION=300

# Integration Testing
INTEGRATION_TEST_ENABLED=true
EXTERNAL_API_MOCK_ENABLED=true
